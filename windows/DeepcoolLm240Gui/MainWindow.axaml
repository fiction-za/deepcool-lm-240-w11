<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeepcoolLm240Gui.MainWindow"
        Title="LM240 LCD"
        Width="740"
        Height="700"
        MinWidth="580"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <TextBlock Grid.Row="0"
               Text="LM240 LCD"
               FontSize="22"
               FontWeight="SemiBold"
               Foreground="#F8FAFC" />
    <TextBlock x:Name="StatusText"
               Grid.Row="1"
               Margin="0,8,0,12"
               Text="Ready"
               FontSize="13"
               Foreground="#94A3B8"
               TextWrapping="Wrap"
               MinHeight="36" />

    <Border Grid.Row="2"
            Background="#020617"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Viewbox Stretch="Uniform">
        <Image x:Name="LcdPreview"
               Width="320"
               Height="240"
               Stretch="Fill"
               RenderOptions.BitmapInterpolationMode="None" />
      </Viewbox>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
      <TextBlock Text="Template" FontSize="12" Foreground="#94A3B8" />
      <ComboBox x:Name="TemplateList"
                MinHeight="36"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="LCD template" />
    </StackPanel>

    <WrapPanel Grid.Row="4" Margin="0,12,0,0">
      <WrapPanel.Styles>
        <Style Selector="Button">
          <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
      </WrapPanel.Styles>
      <Button Content="Game art" Click="OnLoadGameArt" HotKey="Ctrl+O" AutomationProperties.Name="Load game art" />
      <Button Content="Find device" Click="OnFindDevice" HotKey="Ctrl+F" AutomationProperties.Name="Find LM240" />
      <Button x:Name="SendButton" Classes="send" Content="Send to LCD" Click="OnSend" HotKey="Ctrl+S" AutomationProperties.Name="Send frame to LCD" />
    </WrapPanel>
  </Grid>
</Window>
